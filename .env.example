# Bu dosya repoya girer; gerçek değerleri .env dosyasına yazın.

# Neon Postgres bağlantı adresi (pooled connection string)
# NOT: Neon'un kopyaladığı adres "sslmode=require" ile gelir; bunu "verify-full"
# yapın. node-postgres bugün ikisini de tam doğrulama (sertifika + sunucu adı)
# olarak işliyor ama pg v9'da "require" doğrulamayı bırakacak. Açıkça
# "verify-full" yazmak hem uyarıyı susturur hem güvenliği sürümden bağımsız kılar.
DATABASE_URI=postgresql://kullanici:parola@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Payload oturum/şifreleme anahtarı (rastgele uzun bir dize)
PAYLOAD_SECRET=

# Sitenin genel adresi (canonical, OpenGraph, sitemap)
# ÖNEMLİ: Canlıda tarayıcıdaki adresin BİREBİR aynısı olmalı — protokol dahil,
# sondaki "/" olmadan. Yanlışsa panelde çıkış yapma ve içerik kaydetme sessizce
# çalışmaz (Payload isteği "giriş yapılmamış" sayar).
# Değiştirdikten sonra uygulamayı yeniden başlatın.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Panele erişilen ek adresler — virgülle ayırın. Siteye hem www'lu hem www'suz
# ya da birden fazla alan adından girilebiliyorsa hepsini buraya yazın.
# Örn: PAYLOAD_CSRF_ORIGINS=https://www.ornek-firma.com.tr,https://ornek-firma.com.tr
PAYLOAD_CSRF_ORIGINS=

# Panelden yüklenen görsellerin diskteki klasörü.
# Yerelde boş bırakın — proje kökündeki media/ klasörü kullanılır.
# Sunucuda proje klasörünün DIŞINDA mutlak bir yol verin; böylece git pull +
# yeniden build müşterinin yüklediği dosyalara dokunmaz.
# Örn: MEDIA_DIR=/var/www/dogan-iso/media
MEDIA_DIR=

# İletişim formu e-posta bildirimi (opsiyonel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
CONTACT_NOTIFY_TO=

# MCP sunucusu (POST /api/mcp) — canlıda kapatmak için "true" yapın
PAYLOAD_MCP_DISABLED=
