# Bu dosya repoya girer; gerçek değerleri .env dosyasına yazın.

# Neon Postgres bağlantı adresi (pooled connection string)
DATABASE_URI=postgresql://kullanici:parola@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Payload oturum/şifreleme anahtarı (rastgele uzun bir dize)
PAYLOAD_SECRET=

# Sitenin genel adresi (canonical, OpenGraph, sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob okuma/yazma anahtarı
BLOB_READ_WRITE_TOKEN=

# İletişim formu e-posta bildirimi (opsiyonel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
CONTACT_NOTIFY_TO=
